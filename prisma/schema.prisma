generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  RESERVED
  PAID
  CANCELLED
  USED
}

enum Role {
  ADMIN
  USER
}

model User {
  id       String  @id @default(cuid())
  name     String?
  email    String  @unique
  username String? @unique
  password String?
  role     Role    @default(USER)

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Theatre {
  id      String @id @default(cuid())
  name    String
  address String

  seats     Seat[]
  schedules MovieSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Seat {
  id String @id @default(cuid())

  rowLabel   String
  seatNumber Int

  theatre   Theatre    @relation(fields: [theatreId], references: [id])
  theatreId String

  tickets Ticket[]

  @@unique([theatreId, rowLabel, seatNumber])
}

model Movie {
  id          String  @id @default(cuid())
  title       String
  description String?
  duration    Int? // minutes

  schedules MovieSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MovieSchedule {
  id String @id @default(cuid())

  movie   Movie  @relation(fields: [movieId], references: [id])
  movieId String

  theatre   Theatre @relation(fields: [theatreId], references: [id])
  theatreId String

  startTime DateTime
  endTime   DateTime

  tickets Ticket[]

  createdAt DateTime @default(now())

  @@index([movieId])
  @@index([theatreId])
  @@index([startTime])
}

model Ticket {
  id String @id @default(cuid())

  user   User?   @relation(fields: [userId], references: [id])
  userId String?

  seat   Seat   @relation(fields: [seatId], references: [id])
  seatId String

  schedule   MovieSchedule @relation(fields: [scheduleId], references: [id])
  scheduleId String

  status TicketStatus @default(RESERVED)

  bookedAt DateTime  @default(now())
  paidAt   DateTime?

  @@unique([seatId, scheduleId])
  @@index([userId])
  @@index([scheduleId])
}
